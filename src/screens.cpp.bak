#define RGB565(r, g, b) (((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3))

static const char* MONTHS_RU[] = { "января", "февраля",    "марта",  "апреля",    "мая",    "июня", 
                                     "июля", "августа", "сентября", "октября", "ноября", "декабря"};

static const char* WEEKDAYS_RU[] = {  "Воскресенье", "Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота"};

static void drawAgeBadge(TFT_eSprite& sprite,
                         const char* ageBuf,
                         bool haveAge,
                         int ageCat,
                         uint16_t bg_color)
{
  // геометрия бейджа в правом верхнем углу
  const int ageW = 80;
  const int ageH = 18;
  const int ageX = 320 - 5 - ageW;  // 5px от правого края
  const int ageY = 2;

  // цвета по категории
  uint16_t ageBox = bg_color;      // фон бейджа
  uint16_t ageFg  = TFT_DARKGREY;  // цвет текста

  if (haveAge) {
    if (ageCat == 1) {            // <= 5 мин — зелёный текст, фон как фон экрана
      ageBox = bg_color;
      ageFg  = TFT_DARKGREEN;
    } else if (ageCat == 2) {     // 5..15 
      ageBox = bg_color;
      ageFg  = TFT_YELLOW;
    } else if (ageCat == 3) {     // >15 — белый на красном
      ageBox = TFT_RED;
      ageFg  = TFT_WHITE;
    }
  }

  // сам прямоугольник
  sprite.fillRoundRect(ageX, ageY, ageW, ageH, 4, ageBox);

  // текст по центру бейджа
  sprite.setTextDatum(MC_DATUM);
  sprite.setTextColor(ageFg, ageBox);

  char ageLine[20];
  snprintf(ageLine, sizeof(ageLine), "%s мин", ageBuf);
  sprite.drawString(ageLine, ageX + ageW / 2, ageY + ageH / 2);
}


static void drawArrow(int x, int y, int angle, int lenght, int width, int tip, int dx, int wl, int w0, TFT_eSprite& sprite, uint16_t color)
{
  // начало стрелки
  float x0 =  0;
  float y0 = lenght/2;
  // конец стрелки
  float xc = 0;
  float yc = -lenght/2;
  // конец левой линии
  float xl = -width/2;
  float yl = lenght/2 - tip;
  // конец правой линии
  float xr = width/2;
  float yr = yl;
  
  float c = cos((180-angle)*PI/180);
  float s = sin((180-angle)*PI/180);

  int x0r = int( x0*c + y0*s)+x+dx/2;
  int y0r = int(-x0*s + y0*c)+y;

  int xcr = int( xc*c + yc*s)+x+dx/2;
  int ycr = int(-xc*s + yc*c)+y;

  int xlr = int( xl*c + yl*s)+x+dx/2;
  int ylr = int(-xl*s + yl*c)+y;

  int xrr = int( xr*c + yr*s)+x+dx/2;
  int yrr = int(-xr*s + yr*c)+y;

  sprite.drawWedgeLine(xcr, ycr, x0r, y0r, wl, w0, color);
  sprite.drawWedgeLine(xlr, ylr, x0r, y0r, wl, w0, color);
  sprite.drawWedgeLine(xrr, yrr, x0r, y0r, wl, w0, color);
  if (dx > 0){
    sprite.drawWedgeLine(xcr-dx, ycr, x0r-dx, y0r, wl, w0, color);
    sprite.drawWedgeLine(xlr-dx, ylr, x0r-dx, y0r, wl, w0, color);
    sprite.drawWedgeLine(xrr-dx, yrr, x0r-dx, y0r, wl, w0, color);
  }
}

void drawMainScreen(TFT_eSprite& sprite, const NightscoutData& ns) {
  tm tml;
  bool okTime = getLocalTime(&tml, 50);

  const bool okE = ns.okEntries;
  const bool okP = ns.okProps;

  // --- format buffers (NO String allocations) ---
  char timeBuf[6]   = "--:--";
  char sgvBuf[12]   = "--";
  char dltBuf[12]   = "--";
  char iobBuf[16]   = "--";
  char cobBuf[16]   = "--";
  char ageBuf[12]   = "--";

  if (okTime) {
    snprintf(timeBuf, sizeof(timeBuf), "%02d:%02d", tml.tm_hour, tml.tm_min);
  }

  if (okE && !isnan(ns.sgv_mmol)) {
    snprintf(sgvBuf, sizeof(sgvBuf), "%.1f", ns.sgv_mmol);
  }

  if (okP && !isnan(ns.delta_mmol)) {
    snprintf(dltBuf, sizeof(dltBuf), "%+.1f", ns.delta_mmol);
  }

  if (okP && !isnan(ns.iob)) {
    snprintf(iobBuf, sizeof(iobBuf), "%.2f", ns.iob);
  }

  if (okP && !isnan(ns.cob)) {
    snprintf(cobBuf, sizeof(cobBuf), "%.1f", ns.cob);
  }

  // ---- AGE + категории свежести ----
  bool   haveAge = false;
  int    ageMin  = 0;
  int    ageCat  = 0;   // 0=нет, 1<=5мин, 2<=15мин, 3>15мин

  if (okE && ns.sensTime > 0) {
    time_t tnow = time(nullptr);
    if (tnow > ns.sensTime) {
      ageMin = (int)((tnow - ns.sensTime) / 60);
      haveAge = true;
    }
  }

  if (haveAge) {
    snprintf(ageBuf, sizeof(ageBuf), "%d", ageMin);

    if (ageMin <= 5)        ageCat = 1;
    else if (ageMin <= 15)  ageCat = 2;
    else                    ageCat = 3;
  }

  // Если данные слишком старые -> сбрасываем отображение
  if (ageCat == 3) {
    strncpy(sgvBuf, "--", sizeof(sgvBuf));
    strncpy(dltBuf, "--", sizeof(dltBuf));
    strncpy(iobBuf, "--", sizeof(iobBuf));
    strncpy(cobBuf, "--", sizeof(cobBuf));
  }

  // --- draw ---
  const uint16_t bg_color = RGB565(40, 40, 40);
  sprite.fillSprite(bg_color);

  // Time HH:MM (top)
  sprite.setTextDatum(TC_DATUM);
  sprite.setTextColor(TFT_DARKGREY, bg_color);
  sprite.loadFont(comfortaa_bold_18);
  sprite.drawString(timeBuf, 160, 3);

  // IOB / COB bottom
  sprite.setTextDatum(BL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg_color);

  char tmp[24];
  snprintf(tmp, sizeof(tmp), "I: %s", iobBuf);
  sprite.drawString(tmp, 5, 170);

  snprintf(tmp, sizeof(tmp), "C: %s", cobBuf);
  sprite.drawString(tmp, 120, 170);

 // Age badge
  drawAgeBadge(sprite, ageBuf, haveAge, ageCat, bg_color);


  // ---- Pump battery ----
  sprite.setTextDatum(TL_DATUM);

  // geometry
  const int bx = 5;     // main box X
  const int by = 2;     // Y
  const int bw = 42;    // width
  const int bh = 18;    // height

  // "усик"
  sprite.drawRect(bx-3, by+4, 3, bh-8, TFT_DARKGREY);

  // рамка батареи
  sprite.drawRect(bx, by, bw, bh, TFT_DARKGREY);

  // данные
  if (ns.okDevStatus && ns.pumpBatValid) {
      int pct = ns.pumpBatPct;
      if (pct < 0) pct = 0;
      if (pct > 100) pct = 100;

      // выбор цвета для ТЕКСТА
      uint16_t batCol =
          (pct >= 50) ? TFT_GREEN :
          (pct >= 15) ? TFT_YELLOW :
                        TFT_RED;

      // заливка справа -> налево
      int fillW = (bw - 2) * pct / 100;
      if (fillW < 0) fillW = 0;

      if (fillW > 0) {
          // начало справа
          int fx = bx + (bw - 1 - fillW);
          int fy = by + 1;
          sprite.fillRect(fx, fy, fillW, bh - 2, batCol);
      }

      // текст рядом
      snprintf(tmp, sizeof(tmp), "%d%%", pct);
      sprite.setTextColor(TFT_DARKGREY, bg_color);
      sprite.drawString(tmp, bx + bw + 2, by + 2);

  } else {
      // нет данных
      sprite.setTextColor(TFT_DARKGREY, bg_color);
      sprite.drawString("--", bx + bw + 2, by + 2);
  }


  sprite.unloadFont();

  // SGV big
  const uint16_t zoneCol = ns.zoneColor;

  sprite.setTextDatum(MC_DATUM);
  sprite.loadFont(roninset2_180);

  // если данные очень старые, показываем "--" серым
  uint16_t sgvCol = (ageCat == 3 || !ns.zoneValid) ? TFT_DARKGREY : zoneCol;
  sprite.setTextColor(sgvCol, bg_color);
  sprite.drawString(sgvBuf, 120, 100);
  sprite.unloadFont();

  // Trend arrow
  const int x0 = 320 - 42;
  const int y0 = 170 - 42;

  if (okE && ageCat != 3) { // при старых данных стрелку не рисуем
    int a = 0;
    int dx = 0;

    const char* dir = ns.dir; // char[32]
    if      (!strcmp(dir, "Flat"))         a = 90;
    else if (!strcmp(dir, "FortyFiveUp"))  a = 45;
    else if (!strcmp(dir, "FortyFiveDown"))a = 135;
    else if (!strcmp(dir, "SingleUp"))     a = 0;
    else if (!strcmp(dir, "SingleDown"))   a = 180;
    else if (!strcmp(dir, "DoubleUp"))   { a = 0;   dx = 24; }
    else if (!strcmp(dir, "DoubleDown")) { a = 180; dx = 24; }

    drawArrow(x0, y0, a, 60, 16, 15, dx, 4, 2, sprite, TFT_SKYBLUE);
  }

  // Delta
  sprite.setTextDatum(BC_DATUM);
  sprite.loadFont(volkswagen_medium_36);

  uint16_t dltCol = (ageCat == 3 || !okP) ? TFT_DARKGREY : TFT_SKYBLUE;
  sprite.setTextColor(dltCol, bg_color);
  sprite.drawString(dltBuf, x0, y0 - 50);
  sprite.unloadFont();

  sprite.pushSprite(0, 0);
}



void drawClockScreen(TFT_eSprite& sprite, const NightscoutData& ns) {
  const bool okE = ns.okEntries;
  const bool okP = ns.okProps;

  // --- format buffers ---
  char sgvBuf[12] = "--";
  char dltBuf[12] = "--";
  char ageBuf[12] = "--";

  if (okE && !isnan(ns.sgv_mmol)) {
    snprintf(sgvBuf, sizeof(sgvBuf), "%.1f", ns.sgv_mmol);
  }

  if (okP && !isnan(ns.delta_mmol)) {
    snprintf(dltBuf, sizeof(dltBuf), "%+.1f", ns.delta_mmol);
  }

  // ---- AGE + категории ----
  bool   haveAge = false;
  int    ageMin  = 0;
  int    ageCat  = 0;   // 0=нет, 1<=5, 2<=15, 3>15

  if (okE && ns.sensTime > 0) {
    time_t tnow = time(nullptr);
    if (tnow > ns.sensTime) {
      ageMin = (int)((tnow - ns.sensTime) / 60);
      haveAge = true;
    }
  }

  if (haveAge) {
    snprintf(ageBuf, sizeof(ageBuf), "%d", ageMin);

    if (ageMin <= 5)        ageCat = 1;
    else if (ageMin <= 15)  ageCat = 2;
    else                    ageCat = 3;
  }

  // если протухло — сбрасываем отображаемые NS-поля
  if (ageCat == 3) {
    strncpy(sgvBuf, "--", sizeof(sgvBuf));
    strncpy(dltBuf, "--", sizeof(dltBuf));
  }

  const uint16_t bg_color = RGB565(40, 40, 40);
  sprite.fillSprite(bg_color);

  tm tml;
  bool okTime = getLocalTime(&tml, 50);

  // Time / date strings
  char timeStr[6] = "--:--";
  char dateStr[64] = "";
  char wdStr[64]   = "";

  if (okTime) {
    snprintf(timeStr, sizeof(timeStr), "%02d:%02d", tml.tm_hour, tml.tm_min);
    snprintf(dateStr, sizeof(dateStr), "%d %s %d",
             tml.tm_mday, MONTHS_RU[tml.tm_mon], tml.tm_year + 1900);
    snprintf(wdStr, sizeof(wdStr), "%s", WEEKDAYS_RU[tml.tm_wday]);
  }

  // Big time
  sprite.setTextColor(TFT_MAGENTA, bg_color);
  sprite.setTextDatum(MC_DATUM);
  sprite.loadFont(roninset2_180);
  sprite.drawString(timeStr, 160, 100);
  sprite.unloadFont();

  // Date line
  sprite.setTextDatum(BL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg_color);
  sprite.loadFont(comfortaa_bold_18);
  sprite.drawString(dateStr, 5, 170);

  sprite.setTextDatum(BR_DATUM);
  sprite.drawString(wdStr, 315, 170);

  // NS line top
  const uint16_t zoneCol = ns.zoneColor;
  uint16_t zoneColUsed = (ageCat == 3 ? TFT_DARKGREY : zoneCol);

  sprite.setTextDatum(TL_DATUM);
  sprite.setTextColor(zoneColUsed, bg_color);
  sprite.drawString(sgvBuf, 6, 3);

  // delta (right-aligned)
  char topRight[16];
  snprintf(topRight, sizeof(topRight), "%s", dltBuf);

  sprite.setTextDatum(TR_DATUM);
  sprite.setTextColor(zoneColUsed, bg_color);
  sprite.drawString(topRight, 150, 3);

  // Arrow
  int x0 = 170;
  int y0 = 3 + 8;
  int a  = 0;
  int dx = 0;

  if (okE && ageCat != 3) {  // старые данные -> стрелку не рисуем
    const char* dir = ns.dir;
    if      (!strcmp(dir, "Flat"))          a = 90;
    else if (!strcmp(dir, "FortyFiveUp"))   a = 45;
    else if (!strcmp(dir, "FortyFiveDown")) a = 135;
    else if (!strcmp(dir, "SingleUp"))      a = 0;
    else if (!strcmp(dir, "SingleDown"))    a = 180;
    else if (!strcmp(dir, "DoubleUp"))    { a = 0;   dx = 8; }
    else if (!strcmp(dir, "DoubleDown"))  { a = 180; dx = 8; }
  }

  if (okE && ageCat != 3) {
    drawArrow(x0, y0, a, 16, 16, 8, dx, 1, 1, sprite, zoneColUsed);
  }

  // Age badge
  drawAgeBadge(sprite, ageBuf, haveAge, ageCat, bg_color);

  sprite.unloadFont();
  sprite.pushSprite(0, 0);
}

// Обёртка строки с переносами без использования Arduino String
static int drawWrappedLine(TFT_eSprite& sprite,
                           const char* text,
                           int x, int y,
                           int maxW,
                           int lineH,
                           int maxLines)
{
  if (!text) return 0;

  const int n = strlen(text);
  int linesUsed = 0;
  int start = 0;

  // локальный буфер под одну строку
  char lineBuf[128];

  while (start < n && linesUsed < maxLines) {
    // пропустить ведущие пробелы
    while (start < n && text[start] == ' ') start++;
    if (start >= n) break;

    int end = start;
    int lastSpace = -1;

    // подбираем максимально возможный фрагмент, который влезает в maxW
    while (end < n) {
      char c = text[end];
      if (c == ' ') lastSpace = end;

      int len = end - start + 1;
      if (len >= (int)sizeof(lineBuf)) {
        // больше не влазит в наш буфер — останавливаемся
        break;
      }

      memcpy(lineBuf, text + start, len);
      lineBuf[len] = '\0';

      if (sprite.textWidth(lineBuf) > maxW) {
        break;
      }
      end++;
    }

    int cut;
    if (end == start) {
      // даже один символ не влез по ширине -> аварийный сдвиг
      cut = start + 1;
    } else if (end >= n) {
      // дошли до конца строки
      cut = n;
    } else {
      // на end уже НЕ влазит
      if (lastSpace >= start) {
        // перенос по последнему пробелу
        cut = lastSpace;
      } else {
        // перенос внутри слова
        cut = end;
      }
    }

    int len = cut - start;
    if (len <= 0) {
      // защищаемся от зацикливания
      start++;
      continue;
    }
    if (len >= (int)sizeof(lineBuf)) {
      len = sizeof(lineBuf) - 1;
    }

    memcpy(lineBuf, text + start, len);
    // тримим хвостовые пробелы
    while (len > 0 && (lineBuf[len - 1] == ' ' || lineBuf[len - 1] == '\t')) {
      len--;
    }
    lineBuf[len] = '\0';

    if (len > 0) {
      sprite.drawString(lineBuf, x, y + linesUsed * lineH);
      linesUsed++;
    }

    // следующий кусок
    start = cut;
  }

  return linesUsed;
}

void drawLogScreen(TFT_eSprite& sprite, const LogBuffer& logs) {
  const uint16_t bg = TFT_BLACK;
  sprite.fillSprite(bg);

  sprite.unloadFont();   
  sprite.setTextFont(2);
  sprite.setTextSize(1);
  sprite.setTextDatum(TL_DATUM);

  const int lineH   = sprite.fontHeight();
  const int screenW = sprite.width();   // у тебя 320, но лучше так
  const int screenH = sprite.height();  // 170
  const int linesTotal = screenH / lineH;

  struct Item {
    LogEntry e;
    int lines;
  };

  Item items[32];   // запас (LogBuffer = 25)
  int itemCount = 0;
  int usedLines = 0;

  const size_t cnt = logs.count();

  // 1) Считаем с КОНЦА (самые новые), пока влезает
  for (size_t i = 0; i < cnt && itemCount < (int)(sizeof(items)/sizeof(items[0])); i++) {
    LogEntry e = logs.getNewestFirst(i);

    // Собираем "секунды msg" в C-строку
    char msgBuf[128];
    snprintf(msgBuf, sizeof(msgBuf), "%s", e.msg);

    int w = sprite.textWidth(msgBuf);
    int lines = (w <= 0) ? 1 : (w + screenW - 1) / screenW;
    if (lines < 1) lines = 1;

    if (usedLines + lines > linesTotal) {
      break;
    }

    items[itemCount].e     = e;
    items[itemCount].lines = lines;
    itemCount++;
    usedLines += lines;
  }

  // 2) Рисуем в ОБРАТНОМ порядке → старые сверху, новые снизу
  int y = 0;
  for (int i = itemCount - 1; i >= 0; i--) {
    const LogEntry& e = items[i].e;

    uint16_t col = TFT_GREEN;
    if (e.level == LogLevel::Warn)  col = TFT_YELLOW;
    if (e.level == LogLevel::Error) col = TFT_RED;

    sprite.setTextColor(col, bg);

    char msgBuf[128];
    snprintf(msgBuf, sizeof(msgBuf), "%s", e.msg);

    int used = drawWrappedLine(
      sprite,
      msgBuf,
      0,
      y,
      screenW,
      lineH,
      linesTotal
    );

    y += used * lineH;
    if (y >= screenH) break;
  }

  sprite.pushSprite(0, 0);
}

void drawPortalHelpScreen(TFT_eSprite& sprite, const CaptivePortal& portal) {
  const uint16_t bg = TFT_BLACK;
  sprite.fillSprite(bg);

  const int W = 320;
  const int H = 170;

  const int margin = 6;
  const int gap    = 6;

  // ===== Layout =====
  const int qrBig   = 101;  // WiFi QR width
  const int qrSmall = 58;   // URL QR width

  // Big QR top-left
  const int qr1X = margin;
  const int qr1Y = margin;

  // Text block to the right of big QR
  const int t1X = qr1X + qrBig + gap;
  int y = 4;

  // Small QR bottom-right
  const int qr2X = W - margin - qrSmall;
  const int qr2Y = H - margin - qrSmall;

  // ===== Helpers (NO String) =====
  auto wifiEscape = [](const char* in, char* out, size_t outLen) {
    // Escape for WIFI QR: \ ; , :
    // outLen must include '\0'
    if (!out || outLen == 0) return;
    size_t w = 0;
    if (!in) { out[0] = 0; return; }

    for (size_t i = 0; in[i] != '\0'; i++) {
      char c = in[i];
      bool needSlash = (c == '\\' || c == ';' || c == ',' || c == ':');
      if (needSlash) {
        if (w + 1 >= outLen) break;
        out[w++] = '\\';
      }
      if (w + 1 >= outLen) break;
      out[w++] = c;
    }
    out[w] = '\0';
  };

  auto buildUrl = [](const IPAddress& ip, char* out, size_t outLen) {
    // "http://192.168.4.1/"
    snprintf(out, outLen, "http://%u.%u.%u.%u/",
             (unsigned)ip[0], (unsigned)ip[1], (unsigned)ip[2], (unsigned)ip[3]);
  };

  auto drawQr = [&](int bx, int by, int box, const char* payload,
                    // cache:
                    char* lastPayload, size_t lastCap,
                    QRCode& qr, uint8_t* qrData, int qrDataCap,
                    bool& ok, int& usedVer)
  {
    sprite.drawRect(bx - 2, by - 2, box + 4, box + 4, TFT_DARKGREY);

    if (!payload) payload = "";

    // rebuild only when payload changed
    if (strncmp(payload, lastPayload, lastCap) != 0) {
      strlcpy(lastPayload, payload, lastCap);
      ok = false;
      usedVer = 0;

      for (int ver = 3; ver <= 12; ver++) {
        int need = qrcode_getBufferSize(ver);
        if (need > qrDataCap) continue;

        qrcode_initText(&qr, qrData, ver, ECC_MEDIUM, payload);
        ok = true;
        usedVer = ver;
        break;
      }
    }

    if (!ok) {
      sprite.setTextFont(1);
      sprite.setTextColor(TFT_RED, bg);
      sprite.drawString("QR err", bx + 6, by + 6);
      return;
    }

    const int size = qr.size;     // module count
    int scale = box / size;
    if (scale < 1) scale = 1;

    const int px = size * scale;
    const int x0 = bx + (box - px) / 2;
    const int y0 = by + (box - px) / 2;

    sprite.fillRect(x0, y0, px, px, TFT_WHITE);
    for (int j = 0; j < size; j++) {
      for (int i = 0; i < size; i++) {
        if (qrcode_getModule(&qr, i, j)) {
          sprite.fillRect(x0 + i * scale, y0 + j * scale, scale, scale, TFT_BLACK);
        }
      }
    }
  };

  // ===== Data (avoid copies) =====
  const String& ssidS = portal.apSsid();
  const String& passS = portal.apPass();
  const IPAddress ip  = portal.apIP();

  const char* ssid = ssidS.c_str();
  const char* pass = passS.c_str();

  // ===== Payloads in char buffers (NO String concat) =====
  // Worst case with escaping: each char may become "\x" => x2
  // ssid max 32, pass max 64 => need enough space
  char ssidEsc[96];
  char passEsc[192];
  wifiEscape(ssid, ssidEsc, sizeof(ssidEsc));
  wifiEscape(pass, passEsc, sizeof(passEsc));

  char wifiPayload[320];
  snprintf(wifiPayload, sizeof(wifiPayload),
           "WIFI:T:WPA;S:%s;P:%s;;",
           ssidEsc, passEsc);

  char urlPayload[32];
  buildUrl(ip, urlPayload, sizeof(urlPayload));

  // ===== QR caches (NO String) =====
  static char lastWifi[320] = {0};
  static char lastUrl[32]   = {0};

  static QRCode  qrWifi;
  static uint8_t qrWifiData[512];
  static bool    qrWifiOk = false;
  static int     qrWifiVer = 0;

  static QRCode  qrUrl;
  static uint8_t qrUrlData[256];
  static bool    qrUrlOk = false;
  static int     qrUrlVer = 0;

  // ===== Draw QR #1 (WiFi) =====
  drawQr(
    qr1X, qr1Y + 18, qrBig, wifiPayload,
    lastWifi, sizeof(lastWifi),
    qrWifi, qrWifiData, (int)sizeof(qrWifiData),
    qrWifiOk, qrWifiVer
  );

  // ===== Text #1 (right of WiFi QR) =====
  sprite.loadFont(comfortaa_bold_18);
  sprite.setTextDatum(TC_DATUM);
  sprite.setTextColor(TFT_RED, bg);
  sprite.drawString("ИНСТРУКЦИЯ ПО НАСТРОЙКЕ", 160, y);
  sprite.unloadFont();
  y += 18;

  sprite.loadFont(corporate_s_w10_16);
  sprite.setTextDatum(TL_DATUM);

  sprite.setTextColor(TFT_GREENYELLOW, bg);
  sprite.drawString("1) Подключитесь к Wi-Fi:", t1X, y);
  y += 18;

  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("SSID:", t1X, y);
  sprite.setTextColor(TFT_SKYBLUE, bg);
  sprite.drawString(ssid, t1X + 50, y);
  y += 18;

  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("PASS:", t1X, y);
  sprite.setTextColor(TFT_SKYBLUE, bg);
  sprite.drawString(pass, t1X + 50, y);
  sprite.unloadFont();

  // ===== Draw QR #2 (URL) =====
  drawQr(
    qr2X, qr2Y, qrSmall, urlPayload,
    lastUrl, sizeof(lastUrl),
    qrUrl, qrUrlData, (int)sizeof(qrUrlData),
    qrUrlOk, qrUrlVer
  );

  // ===== Text #2 (left of bottom-right QR) =====
  sprite.setTextDatum(BR_DATUM);
  sprite.loadFont(corporate_s_w10_16);

  sprite.setTextColor(TFT_GREENYELLOW, bg);
  sprite.drawString("2) Если портал не открылся,", 320 - qrSmall - 10, 170 - 2 - 18);
  sprite.drawString("перейдите на ",               320 - qrSmall - 10 - 18 * 8, 170 - 2);

  sprite.setTextColor(TFT_SKYBLUE, bg);
  sprite.drawString(urlPayload, 320 - qrSmall - 10, 170 - 2);

  sprite.unloadFont();
  sprite.pushSprite(0, 0);
}

void drawFirstScreen(TFT_eSprite& sprite) {
  const uint16_t bg = TFT_BLACK;
  sprite.fillSprite(bg);

  // ===== Заголовок =====
  sprite.loadFont(comfortaa_bold_18);
  sprite.setTextDatum(TC_DATUM);
  sprite.setTextColor(TFT_RED, bg);
  sprite.drawString("ДОБРО ПОЖАЛОВАТЬ!", 160, 6);
  sprite.unloadFont();

  sprite.loadFont(corporate_s_w10_16);

  // ------- Блок BOOT (верхняя часть) -------
  int yL = 30;
  sprite.setTextColor(TFT_SKYBLUE, bg);
  sprite.drawString("Кнопка сверху", 160, yL);

  yL += 18;
  sprite.setTextDatum(TR_DATUM);
  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("Нажатие:", 155, yL);

  sprite.setTextDatum(TL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg);
  sprite.drawString("яркость подсветки", 165, yL);

  yL += 18;
  sprite.setTextDatum(TR_DATUM);
  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("Долгое (5 сек):", 155, yL);

  sprite.setTextDatum(TL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg);
  sprite.drawString("консоль ошибок", 165, yL);

  // ------- Блок USER (нижняя часть) -------
  int yR = 90;
  sprite.setTextDatum(TC_DATUM);
  sprite.setTextColor(TFT_SKYBLUE, bg);
  sprite.drawString("Кнопка снизу", 160, yR);

  yR += 18;
  sprite.setTextDatum(TR_DATUM);
  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("Нажатие:", 155, yR);

  sprite.setTextDatum(TL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg);
  sprite.drawString("смена экранов", 165, yR);

  yR += 18;
  sprite.setTextDatum(TR_DATUM);
  sprite.setTextColor(TFT_ORANGE, bg);
  sprite.drawString("Долгое (5 сек):", 155, yR);

  sprite.setTextDatum(TL_DATUM);
  sprite.setTextColor(TFT_LIGHTGREY, bg);
  sprite.drawString("настройки", 165, yR);
  sprite.unloadFont();

  yR += 24;
  sprite.setTextDatum(TC_DATUM);
  sprite.loadFont(comfortaa_bold_18);
  //sprite.setTextColor(TFT_RED, bg);
  sprite.fillRoundRect(40, 170-20, 240, 18, 4, TFT_RED);
  sprite.setTextColor(TFT_WHITE, TFT_RED);
  sprite.drawString("Начните с настройки!", 160, yR);

  // ===== Линии к кнопкам + стрелки =====
  uint16_t lc = TFT_DARKGREEN;
  // --- BOOT (верхняя кнопка) ---
  // основная линия от текста к кнопке
  sprite.drawWedgeLine(108, 35,  2, 25, 2, 1, lc);
  sprite.drawWedgeLine(18,  18,  2, 25, 2, 1, lc);
  sprite.drawWedgeLine(16,  34,  2, 25, 2, 1, lc);
  // --- USER (нижняя кнопка) ---
  // основная линия от текста к нижней кнопке
  sprite.drawWedgeLine(112, 96,  2, 133, 2, 1, lc);
  sprite.drawWedgeLine(14, 121,  2, 133, 2, 1, lc);
  sprite.drawWedgeLine(19, 136,  2, 133, 2, 1, lc);

  sprite.unloadFont();
  sprite.pushSprite(0, 0);
}

