#include <Arduino.h>
#include "gfx/LVGL_Display.h"
#include "ui_main.h"
#include "ui_clock.h"
#include "ui_logs.h"

#include "logs.h"
LogBuffer gLogs;

static lv_obj_t* g_scr_main = nullptr;
static lv_obj_t* g_scr_clock = nullptr;
static lv_obj_t* g_scr_logs = nullptr;


enum class ScreenID : uint8_t { Main, Clock, Logs };
static ScreenID g_cur = ScreenID::Main;

// защита от повторной анимации
static bool g_animating = false;

// Загрузить экран с анимацией (и снять блокировку по окончании)
static void load_screen(ScreenID target, lv_screen_load_anim_t anim, uint32_t time = 300)
{
    if (g_animating) return;

    lv_obj_t* scr = nullptr;
    switch (target) {
        case ScreenID::Main:  scr = g_scr_main;  break;
        case ScreenID::Clock: scr = g_scr_clock; break;
        case ScreenID::Logs:  scr = g_scr_logs;  break;
    }
    if (!scr) return;

    g_animating = true;
    g_cur = target;

    lv_screen_load_anim(scr, anim, time, 0, false);

    // LVGL не даёт нам готовый "on animation end" из screen_load_anim,
    // поэтому просто снимаем блокировку таймером.
    lv_timer_create([](lv_timer_t* t){
        g_animating = false;
        lv_timer_del(t);
    }, time + 30, nullptr);
}

static void next_screen_cb(lv_timer_t*)
{
    // цикл: MAIN -> CLOCK -> LOGS -> MAIN
    switch (g_cur) {
        case ScreenID::Main:
            // MAIN -> CLOCK: уезжаем влево
            load_screen(ScreenID::Clock, LV_SCREEN_LOAD_ANIM_MOVE_LEFT, 300);
            break;

        case ScreenID::Clock:
            // CLOCK -> LOGS: LOGS выезжает сверху (сверху вниз)
            load_screen(ScreenID::Logs, LV_SCREEN_LOAD_ANIM_MOVE_BOTTOM, 300);
            break;

        case ScreenID::Logs:
            // LOGS -> MAIN: LOGS уезжает вверх
            // Для "LOGS уехал вверх" грузим MAIN с анимацией MOVE_TOP
            load_screen(ScreenID::Main, LV_SCREEN_LOAD_ANIM_MOVE_TOP, 300);
            break;
    }
}

void setup()
{
    delay(200);
    gfx::LVGL_Display::instance().init();

    g_scr_main  = ui_main_create();
    g_scr_clock = ui_clock_create();
    g_scr_logs  = ui_logs_create();

    ui_logs_set_buffer(&gLogs);
    gLogs.add(LogLevel::Info,  "WiFi connected");
    gLogs.add(LogLevel::Warn,  "Battery low gdfgs ds hdfh ghs hd5yeyeyeer ававпва gsfgdf  hdfhdsh h1235463474");
    gLogs.add(LogLevel::Error, "Sensor timeout");
    gLogs.addf(LogLevel::Warn, "Temp high: %.1f C", 25.3f);
    gLogs.addf(LogLevel::Error, "I2C error: %02X", 200);
    gLogs.add(LogLevel::Error, "200Sensor timeout");
    gLogs.addf(LogLevel::Warn, "200Temp high: %.1f C", 25.3f);
    gLogs.addf(LogLevel::Error, "200I2C error: %02X", 200);
    gLogs.add(LogLevel::Error, "30 timeout");
    gLogs.addf(LogLevel::Warn, "30 high: %.1f C", 25.3f);
    gLogs.addf(LogLevel::Error, "30 error: %02X", 200);
    gLogs.add(LogLevel::Error, "40 timeout");
    gLogs.addf(LogLevel::Warn, "40 high: %.1f C", 25.3f);
    gLogs.addf(LogLevel::Error, "123456789_123456789_123456789_123456789_1234567_123456789_123456789_123456789_123456789_123456");
    //ui_logs_refresh();

    lv_screen_load(g_scr_main);
    g_cur = ScreenID::Main;

    // каждые 10 секунд переключаем
    lv_timer_create(next_screen_cb, 10000, nullptr);
}

