// Можно хранить основной контейнер, если потом понадобятся анимации/переключения
static lv_obj_t *main_screen = nullptr;

// Точки стрелки (горизонтальная вправо)
// (0,10) -> (40,10) — ствол
// (40,10) -> (30,0) и (40,10) -> (30,20) — «ушки» стрелки
static const lv_point_precise_t arrow_points[] = {{0, 15}, {60, 15}, {48, 3}, {60, 15}, {48, 27}};
static int32_t arrow_angle10_raw = 0;   // текущий угол *10, можно >3600 и <0
static lv_obj_t * arrow;

static int32_t norm3600(int32_t a)
{
    a %= 3600;
    if(a < 0) a += 3600;
    return a;
}

static void arrow_anim_cb(void * var, int32_t angle10)
{
    lv_obj_t * obj = (lv_obj_t *)var;
    lv_obj_set_style_transform_angle(obj, angle10, LV_PART_MAIN);
    arrow_angle10_raw = angle10;
}

void arrow_set_angle_deg_via_right(int32_t target_deg, uint32_t time_ms)
{
    if(!arrow) return;

    int32_t start_raw  = arrow_angle10_raw;
    int32_t start_norm = norm3600(start_raw);
    int32_t target10   = norm3600(target_deg * 10);

    // Выбираем путь, который ПЕРЕСЕКАЕТ 0°:
    // если target "справа" (>= start по нормализованным), идём ПРОТИВ часовой через 0
    // если target "слева" (< start), идём ПО часовой через 360
    int32_t diff;
    if(target10 >= start_norm) diff = (target10 - start_norm) - 3600; // отрицательный (CCW), пересекаем 0
    else                       diff = (target10 - start_norm) + 3600; // положительный (CW), пересекаем 360

    if(diff == 0) return;

    int32_t end_raw = start_raw + diff;

    lv_anim_del(arrow, arrow_anim_cb);

    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, arrow);
    lv_anim_set_exec_cb(&a, arrow_anim_cb);
    lv_anim_set_time(&a, time_ms);
    lv_anim_set_values(&a, start_raw, end_raw);
    lv_anim_set_path_cb(&a, lv_anim_path_ease_in_out);
    lv_anim_start(&a);
}
// =     demo
static lv_timer_t * arrow_timer = nullptr;

static void arrow_swing_timer_cb(lv_timer_t * t)
{
    (void)t;
    static bool dir = true;
    int32_t target_deg = dir ? 90 : -90;   // +90, потом -90, потом +90...
    dir = !dir;
    // 1 секунда на поворот, как ты хотел
    arrow_set_angle_deg_via_right(target_deg, 1000);
}

lv_obj_t *ui_main_create()
{
    // Используем текущий экран как корневой
    main_screen = lv_scr_act();
    lv_obj_set_style_bg_color(main_screen, lv_color_black(), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(main_screen, LV_OPA_COVER, LV_PART_MAIN);

    // ---------- Тренд-стрелка ----------
    arrow = lv_line_create(main_screen);
    lv_line_set_points(arrow, arrow_points, sizeof(arrow_points) / sizeof(arrow_points[0]));
    lv_obj_set_style_line_width(arrow, 8, LV_PART_MAIN);
    lv_obj_set_style_line_rounded(arrow, true, LV_PART_MAIN);
    lv_obj_set_style_line_color(arrow, lv_color_hex(0xFF0000), LV_PART_MAIN);

    // pivot по центру bbox (60x30) => (30,15)
    lv_obj_set_style_transform_pivot_x(arrow, 30, LV_PART_MAIN);
    lv_obj_set_style_transform_pivot_y(arrow, 15, LV_PART_MAIN);

    // где будет центр вращения
    int32_t PX = 320 - 40, PY = 170 - 40;
    lv_obj_set_pos(arrow, PX - 30, PY - 15);

    //arrow_set_angle_deg_via_right(300, 300);
//------------------------------------------------------------------------------------------------
    // поставим стартовый угол (чтобы не было "рывка" с 0)
    arrow_angle10_raw = -900;
    lv_obj_set_style_transform_angle(arrow, arrow_angle10_raw, LV_PART_MAIN);

    // таймер раз в секунду меняет цель -90/+90
    arrow_timer = lv_timer_create(arrow_swing_timer_cb, 1000, NULL);

    // если хочешь, чтобы первый поворот начался сразу, можно дернуть колбэк вручную:
    arrow_swing_timer_cb(NULL);

    // ---------- Большой BG в центре ----------
    label_bg = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_bg, lv_color_hex(0xFFFF00), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_bg, &roninset2_180, LV_PART_MAIN);
    lv_label_set_text(label_bg, "5.6");
    lv_obj_align(label_bg, LV_ALIGN_CENTER, -40, 10);

    // ---------- IOB ----------
    label_iob = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_iob, lv_color_make(200, 200, 200), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_iob, &comfortaa_bold_18, LV_PART_MAIN);
    lv_label_set_text(label_iob, "I: 10");
    lv_obj_align(label_iob, LV_ALIGN_BOTTOM_LEFT, 0, 0);

    // ---------- COB ----------
    label_cob = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_cob, lv_color_make(200, 200, 200), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_cob, &comfortaa_bold_18, LV_PART_MAIN);
    lv_label_set_text(label_cob, "C: 10");
    lv_obj_align(label_cob, LV_ALIGN_BOTTOM_LEFT, 120, 0);

    // ---------- Delta ----------
    // якорь 1x1 в центре стрелки
    lv_obj_t * arrow_anchor = lv_obj_create(main_screen);
    lv_obj_set_size(arrow_anchor, 1, 1);
    lv_obj_set_pos(arrow_anchor, PX, PY);
    lv_obj_add_flag(arrow_anchor, LV_OBJ_FLAG_HIDDEN);

    label_delta = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_delta, lv_color_make(255, 0, 0), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_delta, &volkswagen_medium_36, LV_PART_MAIN);
    lv_label_set_text(label_delta, "-0.2");
    lv_obj_align_to(label_delta, arrow_anchor, LV_ALIGN_OUT_TOP_MID, 0, -40);

    // ---------- battery ----------
    label_battery = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_battery, lv_color_make(100, 255, 0), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_battery, &lv_font_montserrat_24, LV_PART_MAIN);
    lv_label_set_text(label_battery, "\uF242"); //\u240-100% \u241-75% \u242-50% \u243-25% \u244-0%
    lv_obj_align(label_battery, LV_ALIGN_TOP_LEFT, 0, 0);

    // ---------- battery label ----------
    label_battery_level = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_battery_level, lv_color_make(100, 255, 0), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_battery_level, &comfortaa_bold_18, LV_PART_MAIN);
    lv_label_set_text(label_battery_level, "50%");
    lv_obj_align_to(label_battery_level, label_battery, LV_ALIGN_OUT_RIGHT_MID, 2, 0);

    // ---------- age ----------
    label_age = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_age, lv_color_make(0, 255, 0), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_age, &comfortaa_bold_18, LV_PART_MAIN);
    lv_label_set_text(label_age, "2 мин");
    lv_obj_align(label_age, LV_ALIGN_TOP_RIGHT, 0, 0);

    //---------- time ----------
    label_time = lv_label_create(main_screen);
    lv_obj_set_style_text_color(label_time, lv_color_make(200, 200, 200), LV_PART_MAIN);
    lv_obj_set_style_text_font(label_time, &comfortaa_bold_18, LV_PART_MAIN);
    lv_label_set_text(label_time, "22:10");
    lv_obj_align(label_time, LV_ALIGN_TOP_MID, 0, 0);

    return main_screen;
}

// ----- функции обновления -----

void ui_main_set_time(const char *text)
{
    if (label_time)
        lv_label_set_text(label_time, text);
}

void ui_main_set_bg(const char *text)
{
    if (label_bg)
        lv_label_set_text(label_bg, text);
}

void ui_main_set_trend(const char *text)
{
    if (label_trend)
        lv_label_set_text(label_trend, text);
}

void ui_main_set_delta(const char *text)
{
    if (label_delta)
        lv_label_set_text(label_delta, text);
}

