#include <Arduino.h>
#include "gfx/LGFX_TDisplayS3.hpp"

LGFX_TDisplayS3 gfx;

void setup()
{
  Serial.begin(115200);
  delay(500);
  Serial.println();
  Serial.println("LGFX only test start");

  gfx.init();
  gfx.setRotation(1);

  Serial.println("Fill RED");
  gfx.fillScreen(TFT_RED);
  delay(1000);

  Serial.println("Fill GREEN");
  gfx.fillScreen(TFT_GREEN);
  delay(1000);

  Serial.println("Fill BLUE");
  gfx.fillScreen(TFT_BLUE);
  delay(1000);

  Serial.println("Drawing white text...");
  gfx.fillScreen(TFT_BLACK);
  gfx.setTextColor(TFT_WHITE, TFT_BLACK);
  gfx.setTextSize(2);
  gfx.setCursor(10, 10);
  gfx.println("Hello LGFX!");
}

void loop()
{
  // ничего, просто висим
  delay(1000);
}
