#include "ui_logs.h"

#include <lvgl.h>
#include <cstdio>
#include <cstdint>
#include <ctime>

// =================== CONFIG ===================
static constexpr int        MAX_ROWS    = 60;   // сколько LVGL label держим (с запасом)
static constexpr uint32_t   REFRESH_MS  = 120;
static constexpr lv_coord_t SB_W        = 4;    // scrollbar width

// =================== LVGL OBJECTS ===================
static lv_obj_t* g_scr_log  = nullptr;
static lv_obj_t* g_root     = nullptr;

static lv_obj_t* g_labels[MAX_ROWS]{};

static lv_obj_t* g_sb_track = nullptr;
static lv_obj_t* g_sb_thumb = nullptr;

// =================== DATA ===================
static const LogBuffer* g_logs = nullptr;
static uint32_t g_last_version = 0;

static size_t g_startOldest = 0;   // oldest-first index
static bool   g_followTail  = true;

// anchor for "not tail" mode
static bool     g_anchorValid  = false;
static uint32_t g_anchorSeqTop = 0;

static lv_coord_t g_w = 0;
static lv_coord_t g_h = 0;

static const lv_font_t* g_font = &lv_font_montserrat_12;
static lv_coord_t g_lineH = 12;

// динамические параметры "сколько записей реально показали"
static int g_shownCount = 0;

// =================== HELPERS ===================
static lv_color_t color_for_level(LogLevel lvl) {
    switch (lvl) {
        case LogLevel::Warn:  return lv_palette_main(LV_PALETTE_YELLOW);
        case LogLevel::Error: return lv_palette_main(LV_PALETTE_RED);
        default:              return lv_palette_main(LV_PALETTE_GREEN);
    }
}

static void hide_all() {
    for (int i = 0; i < MAX_ROWS; i++) {
        if (g_labels[i]) lv_obj_add_flag(g_labels[i], LV_OBJ_FLAG_HIDDEN);
    }
}

// oldestIndex: 0..cnt-1 (0 = oldest)
static LogEntry get_by_oldest_index(const LogBuffer* lb, size_t cnt, size_t oldestIndex) {
    const size_t newestFirst = (cnt - 1) - oldestIndex;
    return lb->getNewestFirst(newestFirst);
}

static bool find_oldest_index_by_seq(const LogBuffer* lb, size_t cnt, uint32_t seq, size_t& outOldestIndex) {
    for (size_t i = 0; i < cnt; i++) {
        LogEntry e = get_by_oldest_index(lb, cnt, i);
        if (e.seq == seq) { outOldestIndex = i; return true; }
    }
    return false;
}

// format frozen log time:
// - real: epoch -> HH:MM:SS
// - uptime: seconds since boot -> HH:MM:SS
static void format_log_time(char* out, size_t n, const LogEntry& e) {
    if (e.ts_is_real) {
        time_t t = (time_t)e.ts;
        tm tmv{};
        localtime_r(&t, &tmv);
        snprintf(out, n, "%02d:%02d:%02d", tmv.tm_hour, tmv.tm_min, tmv.tm_sec);
    } else {
        uint32_t s = e.ts;
        uint32_t h = s / 3600;
        uint32_t m = (s / 60) % 60;
        uint32_t sec = s % 60;
        snprintf(out, n, "%02u:%02u:%02u", (unsigned)h, (unsigned)m, (unsigned)sec);
    }
}

static void update_scrollbar() {
    if (!g_sb_track || !g_sb_thumb || !g_logs) return;

    const size_t cnt = g_logs->count();
    if (cnt == 0) {
        lv_obj_add_flag(g_sb_track, LV_OBJ_FLAG_HIDDEN);
        return;
    }

    const size_t shown = (g_shownCount > 0) ? (size_t)g_shownCount : 1;
    const size_t maxStart = (cnt > shown) ? (cnt - shown) : 0;

    if (maxStart == 0) {
        lv_obj_add_flag(g_sb_track, LV_OBJ_FLAG_HIDDEN);
        return;
    }
    lv_obj_clear_flag(g_sb_track, LV_OBJ_FLAG_HIDDEN);

    lv_coord_t trackH = lv_obj_get_height(g_sb_track);
    if (trackH <= 0) trackH = 1;

    lv_coord_t thumbH = (lv_coord_t)((uint32_t)trackH * (uint32_t)shown / (uint32_t)cnt);
    if (thumbH < 10) thumbH = 10;
    if (thumbH > trackH) thumbH = trackH;

    lv_coord_t maxY = trackH - thumbH;
    lv_coord_t y = (lv_coord_t)((uint32_t)maxY * (uint32_t)g_startOldest / (uint32_t)maxStart);

    lv_obj_set_height(g_sb_thumb, thumbH);
    lv_obj_set_y(g_sb_thumb, y);
}

static void clamp_start_strict() {
    if (!g_logs) { g_startOldest = 0; return; }
    const size_t cnt = g_logs->count();
    if (cnt == 0) { g_startOldest = 0; return; }
    if (g_startOldest >= cnt) g_startOldest = cnt - 1;   // ВАЖНО
}

// =================== CORE RENDER ===================
//
// Умная логика заполнения:
//  - меряем высоту каждой записи после WRAP
//  - если следующая запись не влазит, но остаток < 1 строки,
//    выкидываем предыдущую запись, чтобы освободить место,
//    и показываем начало частичной записи так, чтобы была видна хотя бы 1 строка полностью.
//
static int render_pass(size_t startOldest, bool allowTailAdjust) {
    if (!g_logs) { hide_all(); g_shownCount = 0; return 0; }
    const size_t cnt = g_logs->count();
    if (cnt == 0) { hide_all(); g_shownCount = 0; return 0; }

    if (startOldest >= cnt) {         // <<< ДОБАВИТЬ
        hide_all();
        g_shownCount = 0;
        return 0;
    }

    hide_all();

    const lv_coord_t text_w = g_w - SB_W;
    const lv_coord_t min_tail_visible = g_lineH; // минимум: 1 строка полностью

    // Сначала подготовим тексты и высоты по мере добавления
    size_t indices[MAX_ROWS]{};
    lv_coord_t heights[MAX_ROWS]{};
    int shown = 0;

    lv_coord_t used_h = 0;

    for (int slot = 0; slot < MAX_ROWS; slot++) {
        const size_t idx = startOldest + (size_t)shown;
        if (idx >= cnt) break;

        lv_obj_t* lb = g_labels[slot];
        if (!lb) break;

        LogEntry e = get_by_oldest_index(g_logs, cnt, idx);

        char tbuf[12];
        format_log_time(tbuf, sizeof(tbuf), e);

        // ВАЖНО: время + 1 пробел + msg, всё в одном label => перенос без отступов
        char out[LogBuffer::kMsgLen + 32];
        snprintf(out, sizeof(out), "%s %s", tbuf, e.msg);

        lv_label_set_text(lb, out);

        lv_color_t c = color_for_level(e.level);
        lv_obj_set_style_text_color(lb, c, 0);

        // чередование яркости
        lv_opa_t opa = (e.seq & 1) ? LV_OPA_70 : LV_OPA_100;
        lv_obj_set_style_text_opa(lb, opa, 0);

        // измеряем высоту
        lv_obj_clear_flag(lb, LV_OBJ_FLAG_HIDDEN);
        lv_obj_set_width(lb, text_w);
        lv_obj_update_layout(lb);

        lv_coord_t h = lv_obj_get_height(lb);
        if (h <= 0) h = g_lineH;

        // если влазит целиком — добавляем
        if (used_h + h <= g_h) {
            indices[shown] = idx;
            heights[shown] = h;
            used_h += h;
            shown++;
            continue;
        }

        // не влазит: хотим показать частично внизу (чтобы не было пустоты)
        const lv_coord_t remain = g_h - used_h;

        if (allowTailAdjust && shown > 0 && remain < min_tail_visible) {
            // Остаток слишком маленький, будет "торчать парой пикселей".
            // Убираем предыдущую запись, освобождаем место, и попробуем снова.
            used_h -= heights[shown - 1];
            shown--;

            // прячем label предыдущей записи (мы его переиспользуем)
            // shown==кол-во полных записей, слот текущий надо пересчитать
            // откатим slot на 1, чтобы перезаписать текущий label корректно
            slot--;
            continue;
        }

        // показываем частично: ставим Y так, чтобы НАЧАЛО записи было видно максимально,
        // но при этом на экране была хотя бы 1 строка.
        // Если remain >= 1 строки — ставим в used_h как обычно.
        // Если remain < 1 строки — мы сюда попадём только если shown==0 (иначе выкинули предыдущую).
        indices[shown] = idx;
        heights[shown] = h;
        shown++;

        // дальше не идём — это последняя (частичная) запись
        break;
    }

    // Раскладка по Y вручную
    lv_coord_t y = 0;
    for (int i = 0; i < shown && i < MAX_ROWS; i++) {
        lv_obj_t* lb = g_labels[i];
        if (!lb) break;

        // label уже имеет нужный текст (мы выше его выставляли),
        // но могли "выкинуть" одну запись и перезаписать — поэтому безопаснее:
        const size_t idx = indices[i];
        LogEntry e = get_by_oldest_index(g_logs, cnt, idx);

        char tbuf[12];
        format_log_time(tbuf, sizeof(tbuf), e);

        char out[LogBuffer::kMsgLen + 32];
        snprintf(out, sizeof(out), "%s %s", tbuf, e.msg);

        lv_label_set_text(lb, out);

        lv_color_t c = color_for_level(e.level);
        lv_obj_set_style_text_color(lb, c, 0);
        lv_opa_t opa = (e.seq & 1) ? LV_OPA_70 : LV_OPA_100;
        lv_obj_set_style_text_opa(lb, opa, 0);

        lv_obj_clear_flag(lb, LV_OBJ_FLAG_HIDDEN);

        lv_obj_set_pos(lb, 0, y);
        lv_obj_set_width(lb, text_w);
        lv_obj_update_layout(lb);

        lv_coord_t h = lv_obj_get_height(lb);
        if (h <= 0) h = heights[i];

        // Если это последняя запись и она "частичная":
        // мы гарантируем, что видна хотя бы 1 строка (остальное клипнется корневым контейнером)
        if (i == shown - 1) {
            lv_coord_t remain = g_h - y;
            if (remain < g_lineH) {
                // сдвигаем вверх так, чтобы было видно 1 строку
                y = g_h - g_lineH;
                if (y < 0) y = 0;
                lv_obj_set_y(lb, y);
            }
        }

        y += h;
    }

    // спрятать оставшиеся labels
    for (int i = shown; i < MAX_ROWS; i++) {
        if (g_labels[i]) lv_obj_add_flag(g_labels[i], LV_OBJ_FLAG_HIDDEN);
    }

    g_shownCount = shown;
    return shown;
}

static void render_force() {
    if (!g_scr_log || !g_root) return;

    if (!g_logs || g_logs->count() == 0) {
        hide_all();
        update_scrollbar();
        return;
    }

    clamp_start_strict();

    const size_t cnt = g_logs->count();

    // 1) Рендер с текущего старта
    const bool wantTail = g_followTail;
    int shown = render_pass(g_startOldest, true);

    // 2) Если хотим хвост — пересчёт старта по факту показанных
    if (wantTail && shown > 0) {
        size_t desiredStart = 0;
        if (cnt > (size_t)shown) desiredStart = cnt - (size_t)shown;
        if (desiredStart != g_startOldest) {
            g_startOldest = desiredStart;
            shown = render_pass(g_startOldest, false);
        }
        g_followTail = true;
        g_anchorValid = false;
    }

    // 3) Обновляем anchor/followTail
    if (g_logs) {
        const size_t shown2 = (g_shownCount > 0) ? (size_t)g_shownCount : 1;
        const size_t maxStart = (cnt > shown2) ? (cnt - shown2) : 0;

        const bool tailNow = (g_startOldest >= maxStart);
        g_followTail = tailNow;

        if (!g_followTail && cnt > 0 && g_shownCount > 0) {
            LogEntry top = get_by_oldest_index(g_logs, cnt, g_startOldest);
            g_anchorSeqTop = top.seq;
            g_anchorValid  = true;
        } else {
            g_anchorValid = false;
        }
    }

    update_scrollbar();
}

static void on_buffer_changed() {
    if (!g_logs) return;

    const size_t cnt = g_logs->count();
    if (cnt == 0) { g_startOldest = 0; render_force(); return; }

    clamp_start_strict();

    if (g_followTail) {
        render_force();
        return;
    }

    // якорь: удерживаем верхнюю запись по seq
    if (g_anchorValid) {
        size_t found = 0;
        if (find_oldest_index_by_seq(g_logs, cnt, g_anchorSeqTop, found)) {
            g_startOldest = found;
        }
    }

    // clamp по фактическому shownCount
    const size_t shown = (g_shownCount > 0) ? (size_t)g_shownCount : 1;
    const size_t maxStart = (cnt > shown) ? (cnt - shown) : 0;
    if (g_startOldest > maxStart) g_startOldest = maxStart;

    render_force();
}

static void render_if_needed() {
    if (!g_logs) return;
    const uint32_t ver = g_logs->version();
    if (ver == g_last_version) return;
    g_last_version = ver;
    on_buffer_changed();
}

static void logs_timer_cb(lv_timer_t*) {
    render_if_needed();
}

// =================== PUBLIC API ===================
lv_obj_t* ui_logs_create() {
    g_scr_log = lv_obj_create(nullptr);
    lv_obj_set_style_bg_color(g_scr_log, lv_color_black(), 0);
    lv_obj_set_style_border_width(g_scr_log, 0, 0);
    lv_obj_set_style_pad_all(g_scr_log, 0, 0);

    g_w = lv_disp_get_hor_res(nullptr);
    g_h = lv_disp_get_ver_res(nullptr);

    g_lineH = lv_font_get_line_height(g_font);
    if (g_lineH < 10) g_lineH = 10;

    // root: plain container (NO FLEX!)
    g_root = lv_obj_create(g_scr_log);
    lv_obj_set_size(g_root, g_w - SB_W, g_h);
    lv_obj_align(g_root, LV_ALIGN_TOP_LEFT, 0, 0);
    lv_obj_set_style_bg_opa(g_root, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(g_root, 0, 0);
    lv_obj_set_style_pad_all(g_root, 0, 0);
    lv_obj_clear_flag(g_root, LV_OBJ_FLAG_SCROLLABLE);

    // LVGL 9.4: clip children via style (so last entry can be partial)
    lv_obj_set_style_clip_corner(g_root, true, 0);

    // Create labels (stacked manually)
    const lv_coord_t text_w = (g_w - SB_W);
    for (int i = 0; i < MAX_ROWS; i++) {
        lv_obj_t* lb = lv_label_create(g_root);
        g_labels[i] = lb;

        lv_obj_set_pos(lb, 0, 0);
        lv_obj_set_width(lb, text_w);
        lv_obj_set_style_text_font(lb, g_font, 0);
        lv_obj_set_style_text_line_space(lb, 0, 0);
        lv_obj_set_style_text_letter_space(lb, 0, 0);

        lv_label_set_long_mode(lb, LV_LABEL_LONG_WRAP);
        lv_label_set_text(lb, "");

        lv_obj_add_flag(lb, LV_OBJ_FLAG_HIDDEN);
    }

    // scrollbar
    g_sb_track = lv_obj_create(g_scr_log);
    lv_obj_set_size(g_sb_track, SB_W, g_h);
    lv_obj_align(g_sb_track, LV_ALIGN_TOP_RIGHT, 0, 0);
    lv_obj_set_style_bg_opa(g_sb_track, LV_OPA_10, 0);
    lv_obj_set_style_border_width(g_sb_track, 0, 0);
    lv_obj_set_style_pad_all(g_sb_track, 0, 0);
    lv_obj_clear_flag(g_sb_track, LV_OBJ_FLAG_SCROLLABLE);

    g_sb_thumb = lv_obj_create(g_sb_track);
    lv_obj_set_width(g_sb_thumb, SB_W);
    lv_obj_set_style_bg_opa(g_sb_thumb, LV_OPA_60, 0);
    lv_obj_set_style_border_width(g_sb_thumb, 0, 0);
    lv_obj_set_style_pad_all(g_sb_thumb, 0, 0);
    lv_obj_clear_flag(g_sb_thumb, LV_OBJ_FLAG_SCROLLABLE);

    lv_timer_create(logs_timer_cb, REFRESH_MS, nullptr);

    // reset state
    g_logs         = nullptr;
    g_last_version = 0;
    g_startOldest  = 0;
    g_followTail   = true;
    g_anchorValid  = false;
    g_shownCount   = 0;

    hide_all();
    update_scrollbar();
    return g_scr_log;
}

void ui_logs_set_buffer(const LogBuffer* logs) {
    g_logs = logs;
    g_last_version = 0;
    g_startOldest  = 0;
    g_followTail   = true;
    g_anchorValid  = false;
    g_shownCount   = 0;

    render_force();
}

void ui_logs_refresh() {
    g_last_version = 0;
    render_force();
}

void ui_logs_scroll(int delta) {
    if (!g_logs) return;
    const size_t cnt = g_logs->count();
    if (cnt == 0) return;

    // Текущая оценка сколько записей на экране
    const size_t shown    = (g_shownCount > 0) ? (size_t)g_shownCount : 1;
    const size_t maxStart = (cnt > shown) ? (cnt - shown) : 0;

    if (delta > 0) { // вверх к старым
        if (g_startOldest > 0) g_startOldest--;
        g_followTail = false;
    } else if (delta < 0) { // вниз к новым
        if (g_startOldest < maxStart) {
            g_startOldest++;
            g_followTail = false;
        } else {
            // мы в "хвостовой зоне" — включаем tail, render_force сам прижмёт к концу
            g_followTail = true;
        }
    }

    // Жёсткий clamp: startOldest НИКОГДА не должен уходить за cnt-1
    if (g_startOldest >= cnt) g_startOldest = (cnt > 0) ? (cnt - 1) : 0;

    render_force();
}

void ui_logs_scroll_page(int delta) {
    if (!g_logs) return;
    const size_t cnt = g_logs->count();
    if (cnt == 0) return;

    const size_t shown    = (g_shownCount > 0) ? (size_t)g_shownCount : 1;
    const size_t maxStart = (cnt > shown) ? (cnt - shown) : 0;
    const size_t page     = (shown > 2) ? (shown - 2) : 1;

    if (delta > 0) { // page up
        if (g_startOldest > 0) {
            g_startOldest = (g_startOldest > page) ? (g_startOldest - page) : 0;
        }
        g_followTail = false;
    } else if (delta < 0) { // page down
        if (g_startOldest < maxStart) {
            size_t next = g_startOldest + page;
            if (next > maxStart) next = maxStart;
            g_startOldest = next;
            g_followTail = false;
        } else {
            g_followTail = true;
        }
    }

    if (g_startOldest >= cnt) g_startOldest = (cnt > 0) ? (cnt - 1) : 0;

    render_force();
}


